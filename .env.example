# Server only. Never prefix these variables with VITE_.
# Dein selbst gewähltes, festes Gästepasswort (12 bis 512 Zeichen).
# In .env.local setzen; hier kein echtes Passwort eintragen.
GUEST_PASSWORD=Test
# Interner Signaturschlüssel, kein Gästepasswort. Erzeugt mit npm run setup:guest.
GUEST_SESSION_SECRET=
# Exact public origin, without a trailing slash. Required on Vercel.
APP_ORIGIN=https://your-site.vercel.app
# Shared login throttling is required on Vercel. Not needed for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dropbox file request; returned only after guest login.
DROPBOX_FILE_REQUEST_URL=
